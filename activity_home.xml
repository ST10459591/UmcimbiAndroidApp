<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- FULL SCREEN BACKGROUND IMAGE -->

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/home"
        android:scaleType="centerCrop"
        android:contentDescription="@string/home_background" />


    <!-- MAIN HOMEPAGE LAYOUT -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@android:color/transparent">

        <!-- WHITE HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="UMCIMBI"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#111111" />

            <!-- LANGUAGE SELECTOR -->

            <TextView
                android:id="@+id/languageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EN  ▾"
                android:textSize="13sp"
                android:textColor="#111111"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/select_language" />

        </LinearLayout>

        <!-- SCROLLABLE MAIN CONTENT -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:background="@android:color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- WELCOME HEADING -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/plan_event"
                    android:textColor="#FFFFFF"
                    android:textSize="29sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_subtitle"
                    android:textColor="#BBBBBB"
                    android:textSize="17sp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="22dp" />

                <!-- SEARCH BUTTON -->

                <Button
                    android:id="@+id/searchServicesButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/search_event_services"
                    android:textAllCaps="false"
                    android:textColor="#111111"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginBottom="28dp" />

                <!-- EXPLORE EVENTS -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/explore_events"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <!-- EVENT ROW 1 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <!-- WEDDINGS -->

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/weddings"
                        android:textStyle="bold"
                        android:textSize="17sp"
                        android:textColor="#FFFFFF"
                        android:background="#343434"
                        android:layout_marginEnd="6dp" />

                    <!-- BIRTHDAYS -->

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/birthdays"
                        android:textStyle="bold"
                        android:textSize="17sp"
                        android:textColor="#FFFFFF"
                        android:background="#343434"
                        android:layout_marginStart="6dp" />

                </LinearLayout>

                <!-- EVENT ROW 2 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="28dp">

                    <!-- CORPORATE EVENTS -->

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/corporate_events"
                        android:textStyle="bold"
                        android:textSize="17sp"
                        android:textColor="#FFFFFF"
                        android:background="#343434"
                        android:layout_marginEnd="6dp" />

                    <!-- GRADUATIONS -->

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/graduations"
                        android:textStyle="bold"
                        android:textSize="17sp"
                        android:textColor="#FFFFFF"
                        android:background="#343434"
                        android:layout_marginStart="6dp" />

                </LinearLayout>

                <!-- SERVICES SECTION -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/find_your_service"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <!-- BROWSE CATEGORIES BUTTON -->

                <Button
                    android:id="@+id/categoriesButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/browse_all_categories"
                    android:textAllCaps="false"
                    android:textColor="#111111"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginBottom="20dp" />

            </LinearLayout>

        </ScrollView>

        <!-- BOTTOM NAVIGATION BAR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#FFFFFF">

            <!-- HOME -->

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/nav_home"
                android:textColor="#111111"
                android:textSize="12sp" />

            <!-- EXPLORE -->

            <TextView
                android:id="@+id/exploreButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/nav_explore"
                android:textColor="#666666"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />

            <!-- BOOKINGS -->

            <TextView
                android:id="@+id/bookingsButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/nav_bookings"
                android:textColor="#666666"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />

            <!-- MESSAGES -->

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/nav_messages"
                android:textColor="#666666"
                android:textSize="12sp" />

            <!-- PROFILE -->

            <TextView
                android:id="@+id/profileButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/nav_profile"
                android:textColor="#666666"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
