<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F3F3">

    <!-- TOP HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="‹"
            android:textSize="32sp"
            android:gravity="center"
            android:textColor="#111111"
            android:contentDescription="@string/back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="UMCIMBI"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#111111" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />

    </LinearLayout>

    <!-- BACKGROUND AREA -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- UMCIMBI LOGO BACKGROUND -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <!-- SOFT WHITE OVERLAY -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CCFFFFFF" />

        <!-- SCROLLABLE CONTENT -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- PAGE TITLE -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/my_business_profile"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:layout_marginBottom="8dp" />

                <!-- BUSINESS STATUS -->
                <TextView
                    android:id="@+id/businessStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/loading_business"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    android:layout_marginBottom="20dp" />

                <!-- BUSINESS NAME -->
                <EditText
                    android:id="@+id/businessNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/business_name"
                    android:inputType="textCapWords"
                    android:singleLine="true"
                    android:background="@drawable/bg_input"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp" />

                <!-- BUSINESS CATEGORY -->
                <Spinner
                    android:id="@+id/categorySpinner"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input"
                    android:padding="10dp"
                    android:layout_marginBottom="12dp" />

                <!-- BUSINESS DESCRIPTION -->
                <EditText
                    android:id="@+id/descriptionInput"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:hint="@string/business_description"
                    android:inputType="textCapSentences|textMultiLine"
                    android:gravity="top"
                    android:background="@drawable/bg_input"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp" />

                <!-- BUSINESS LOCATION -->
                <EditText
                    android:id="@+id/locationInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/business_location"
                    android:inputType="textCapWords"
                    android:background="@drawable/bg_input"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp" />

                <!-- BUSINESS PRICE -->
                <EditText
                    android:id="@+id/priceInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/business_price"
                    android:inputType="numberDecimal"
                    android:background="@drawable/bg_input"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp" />

                <!-- BUSINESS AVAILABILITY -->
                <Spinner
                    android:id="@+id/availabilitySpinner"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input"
                    android:padding="10dp"
                    android:layout_marginBottom="12dp" />

                <!-- BUSINESS PHONE -->
                <EditText
                    android:id="@+id/phoneInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/business_phone"
                    android:inputType="phone"
                    android:background="@drawable/bg_input"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp" />

                <!-- BUSINESS EMAIL -->
                <EditText
                    android:id="@+id/emailInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/business_email"
                    android:inputType="textEmailAddress"
                    android:background="@drawable/bg_input"
                    android:padding="14dp"
                    android:layout_marginBottom="20dp" />

                <!-- BUSINESS PHOTOS HEADING -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/business_photos"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:layout_marginBottom="8dp" />

                <!-- BUSINESS PHOTOS DESCRIPTION -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/business_photos_description"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="14dp" />

                <!-- BUSINESS PHOTO GALLERY -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:fillViewport="true"
                    android:scrollbars="none"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:id="@+id/businessPhotosContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/noBusinessPhotosText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/no_business_photos"
                            android:textSize="14sp"
                            android:textColor="#888888"
                            android:padding="12dp" />

                    </LinearLayout>

                </HorizontalScrollView>

                <!-- ADD BUSINESS PHOTOS BUTTON -->
                <Button
                    android:id="@+id/addBusinessPhotosButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="@string/add_business_photos"
                    android:textAllCaps="false"
                    android:textColor="#111111"
                    android:backgroundTint="#DDDDDD"
                    android:layout_marginBottom="10dp" />

                <!-- PHOTO UPLOAD STATUS -->
                <TextView
                    android:id="@+id/photoUploadStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/business_photos_limit"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="20dp" />

                <!-- SAVE BUSINESS DETAILS -->
                <Button
                    android:id="@+id/saveBusinessButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/save_business"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#111111" />

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

    <!-- BOTTOM NAVIGATION -->
    <include layout="@layout/layout_bottom_navigation" />

</LinearLayout>
