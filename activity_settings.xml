<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/settings_background">

    <!-- BACKGROUND AREA -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- BACKGROUND IMAGE -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <!-- SOFT WHITE OVERLAY -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CCFFFFFF" />

        <!-- SCROLLABLE SETTINGS CONTENT -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- HEADER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:background="@color/settings_surface">

                    <TextView
                        android:id="@+id/backButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="‹"
                        android:textColor="@color/settings_primary_text"
                        android:textSize="32sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/back" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="UMCIMBI"
                        android:textColor="@color/settings_primary_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="40dp"
                        android:layout_height="40dp" />

                </LinearLayout>

                <!-- HEADER DIVIDER -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/settings_divider" />

                <!-- SETTINGS CONTENT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- SETTINGS TITLE -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings"
                        android:textColor="@color/settings_primary_text"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_description"
                        android:textColor="@color/settings_secondary_text"
                        android:textSize="13sp"
                        android:layout_marginBottom="28dp" />

                    <!-- PROFILE HEADING -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_heading"
                        android:textColor="@color/settings_primary_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <!-- PROFILE CARD -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/settings_surface"
                        android:padding="16dp"
                        android:layout_marginBottom="26dp">

                        <!-- FULL NAME -->
                        <EditText
                            android:id="@+id/nameInput"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint="@string/full_name"
                            android:inputType="textPersonName"
                            android:singleLine="true"
                            android:textColor="@color/settings_primary_text"
                            android:textColorHint="@color/settings_secondary_text"
                            android:background="@drawable/bg_input"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:layout_marginBottom="14dp" />

                        <!-- PHONE NUMBER -->
                        <EditText
                            android:id="@+id/phoneInput"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint="@string/phone_number"
                            android:inputType="phone"
                            android:singleLine="true"
                            android:textColor="@color/settings_primary_text"
                            android:textColorHint="@color/settings_secondary_text"
                            android:background="@drawable/bg_input"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp" />

                    </LinearLayout>

                    <!-- PREFERENCES HEADING -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/preferences_heading"
                        android:textColor="@color/settings_primary_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <!-- PREFERENCES CARD -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/settings_surface"
                        android:padding="16dp"
                        android:layout_marginBottom="26dp">

                        <!-- LANGUAGE -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/language"
                            android:textColor="@color/settings_primary_text"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <Spinner
                            android:id="@+id/languageSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_input"
                            android:layout_marginBottom="12dp" />

                        <!-- NOTIFICATIONS -->
                        <Switch
                            android:id="@+id/notificationSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="@string/enable_notifications"
                            android:textColor="@color/settings_primary_text" />

                        <!-- DARK MODE -->
                        <Switch
                            android:id="@+id/darkModeSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="@string/dark_mode"
                            android:textColor="@color/settings_primary_text" />

                    </LinearLayout>

                    <!-- ACCOUNT HEADING -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/account_heading"
                        android:textColor="@color/settings_primary_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <!-- SAVE SETTINGS -->

                    <Button
                        android:id="@+id/saveButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/save_settings"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:background="@drawable/bg_button_black"
                        android:backgroundTint="@null"
                        android:stateListAnimator="@null"
                        android:layout_marginBottom="10dp" />


                    <!-- LOGOUT -->

                    <Button
                        android:id="@+id/logoutButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/logout"
                        android:textAllCaps="false"
                        android:textColor="@color/settings_primary_text"
                        android:textStyle="bold"
                        android:background="@drawable/bg_button_outline"
                        android:backgroundTint="@null"
                        android:stateListAnimator="@null" />


                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

    <!-- BOTTOM NAVIGATION -->
    <include layout="@layout/layout_bottom_navigation" />

</LinearLayout>
