<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F3F3">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="32sp"
            android:textColor="#111111"
            android:contentDescription="@string/back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="UMCIMBI"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111111" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />

    </LinearLayout>

    <!-- BACKGROUND AREA -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- UMCIMBI LOGO BACKGROUND -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <!-- SOFT WHITE OVERLAY -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CCFFFFFF" />

        <!-- SCROLLABLE DASHBOARD CONTENT -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- DASHBOARD TITLE -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/provider_dashboard"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:layout_marginBottom="8dp" />

                <!-- DESCRIPTION -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/provider_dashboard_description"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="24dp" />

                <!-- BUSINESS NAME CARD -->
                <TextView
                    android:id="@+id/businessNameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/loading_business"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:background="#FFFFFF"
                    android:padding="20dp"
                    android:layout_marginBottom="20dp" />

                <!-- MY BUSINESS PROFILE BUTTON -->
                <Button
                    android:id="@+id/myBusinessButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/my_business_profile"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#111111"
                    android:layout_marginBottom="12dp" />

                <!-- BOOKING REQUESTS BUTTON -->
                <Button
                    android:id="@+id/bookingRequestsButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/provider_booking_requests_title"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#111111"
                    android:layout_marginBottom="12dp" />

                <!-- MESSAGES BUTTON -->
                <Button
                    android:id="@+id/providerMessagesButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/messages"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#111111" />

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

    <!-- BOTTOM NAVIGATION -->
    <include layout="@layout/layout_bottom_navigation" />

</LinearLayout>
