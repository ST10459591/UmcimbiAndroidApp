<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:minHeight="600dp">

        <!-- REGISTRATION CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_welcome_card"
            android:padding="28dp">

            <!-- UMCIMBI LOGO -->
            <TextView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/logo"
                android:gravity="center"
                android:text="U"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />

            <!-- APP NAME -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="UMCIMBI"
                android:textColor="#000000"
                android:textSize="36sp"
                android:textStyle="bold" />

            <!-- SUBTITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="28dp"
                android:text="Create your account"
                android:textColor="#666666"
                android:textSize="14sp" />

            <!-- FULL NAME -->
            <EditText
                android:id="@+id/nameInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Full Name"
                android:inputType="textPersonName"
                android:singleLine="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="12dp" />

            <!-- EMAIL -->
            <EditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Email address"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="12dp" />

            <!-- PASSWORD -->
            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Password"
                android:inputType="textPassword"
                android:singleLine="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="10dp" />

            <!-- PASSWORD REQUIREMENT -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password must be at least 6 characters"
                android:textColor="#777777"
                android:textSize="12sp"
                android:layout_marginBottom="24dp" />

            <!-- ACCOUNT TYPE HEADING -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="I am registering as a:"
                android:textColor="#111111"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- ACCOUNT TYPE SELECTION -->
            <RadioGroup
                android:id="@+id/accountTypeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp">

                <!-- CUSTOMER -->
                <RadioButton
                    android:id="@+id/customerRadio"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Customer"
                    android:textColor="#111111"
                    android:textSize="15sp"
                    android:buttonTint="#111111"
                    android:checked="true"
                    android:paddingStart="8dp" />

                <!-- SERVICE PROVIDER -->
                <RadioButton
                    android:id="@+id/providerRadio"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Service Provider"
                    android:textColor="#111111"
                    android:textSize="15sp"
                    android:buttonTint="#111111"
                    android:paddingStart="8dp" />

            </RadioGroup>

            <!-- ACCOUNT TYPE DESCRIPTION -->
            <TextView
                android:id="@+id/accountTypeDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Find and book services for your events."
                android:textColor="#666666"
                android:textSize="12sp"
                android:layout_marginBottom="24dp" />

            <!-- CREATE ACCOUNT BUTTON -->
            <Button
                android:id="@+id/registerButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Create Account"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#000000"
                android:stateListAnimator="@null" />

            <!-- FOOTER -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="Join UMCIMBI and make event planning easier."
                android:textColor="#666666"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
