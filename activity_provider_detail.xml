<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F3F3">

    <!-- BACKGROUND IMAGE -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/decor"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- SOFT WHITE OVERLAY -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CCFFFFFF" />

    <!-- SCROLLABLE PAGE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="#FFFFFF"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <TextView
                    android:id="@+id/backButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textSize="32sp"
                    android:textColor="#111111"
                    android:contentDescription="Go back" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="UMCIMBI"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#111111" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp" />

            </LinearLayout>

            <!-- MAIN CONTENT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Provider Profile"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:layout_marginBottom="20dp" />

                <!-- PROVIDER INFORMATION -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="#FFFFFF">

                    <TextView
                        android:id="@+id/businessNameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loading provider..."
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:textColor="#111111"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/categoryText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#555555"
                        android:textSize="15sp"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/descriptionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#555555"
                        android:textSize="15sp"
                        android:layout_marginBottom="18dp" />

                    <TextView
                        android:id="@+id/locationText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#111111"
                        android:textSize="15sp"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/priceText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#111111"
                        android:textSize="15sp"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/ratingText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#111111"
                        android:textSize="15sp"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/availabilityText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#111111"
                        android:textSize="15sp"
                        android:layout_marginBottom="10dp" />

                </LinearLayout>

                <!-- BUSINESS PHOTOS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BUSINESS PHOTOS"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#111111"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/noProviderPhotosText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No business photos available"
                        android:textColor="#777777"
                        android:textSize="14sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/providerPhotosContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                    </HorizontalScrollView>

                </LinearLayout>

                <!-- CONTACT INFORMATION -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CONTACT INFORMATION"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#111111"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/phoneText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Phone: Loading..."
                        android:textColor="#111111"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/emailText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Email: Loading..."
                        android:textColor="#111111"
                        android:textSize="15sp" />

                </LinearLayout>

                <!-- ACTION BUTTONS -->
                <Button
                    android:id="@+id/contactButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:text="Contact Provider"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#111111"
                    android:enabled="false" />

                <Button
                    android:id="@+id/messageButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="Message Provider"
                    android:textAllCaps="false"
                    android:textColor="#111111"
                    android:backgroundTint="#DDDDDD"
                    android:enabled="false" />

                <Button
                    android:id="@+id/bookProviderButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:text="Request Booking"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#222222" />

                <Button
                    android:id="@+id/favouriteButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:text="♡ Add to Favourites"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#333333" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
